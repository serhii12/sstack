{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\" || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.githooks/**)",
      "Edit(/.stack/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)"
    ]
  }
}
