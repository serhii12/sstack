{
  "description": "sstack git guard",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.codex/hooks/guard-git.mjs\" || exit 2",
            "timeout": 30,
            "statusMessage": "sstack git guard"
          }
        ]
      }
    ]
  }
}
